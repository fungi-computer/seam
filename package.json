{
  "name": "@fungi.computer/seam",
  "version": "0.2.6",
  "author": "Levi <levi@technomancy.dev>",
  "private": false,
  "description": "Ed25519 authentication between Fungi Hub and on-box hosts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./machine-link-protocol": {
      "types": "./dist/machine-link-protocol.d.ts",
      "import": "./dist/machine-link-protocol.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "node test/stranger/runtime.mjs",
    "prepack": "node scripts/prepare-package.mjs"
  },
  "dependencies": {
    "@fungi.computer/carrier": "0.2.5",
    "effect": "4.0.2"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "license": "MIT",
  "botanical": {
    "role": "package",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": "required",
      "pack": "required",
      "smoke": "required",
      "stranger": "required"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/seam.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "directory": ".botanical/package",
    "linkDirectory": false
  }
}
